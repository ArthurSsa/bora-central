# Copie para worker/.env e preencha. O .env está no .gitignore.

# Supabase → Project Settings → API Keys → secret (service_role).
# O worker escreve em jobs e no balde "pedidos" com ela; nunca vai pro navegador.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=https://yxewmauwnxnrrhevlbtc.supabase.co

# Chave da API da Anthropic (console.anthropic.com). Os tokens dos jobs são
# cobrados nela — é o número que entra na precificação por conta.
ANTHROPIC_API_KEY=

# Opcionais
# FABRICA_MODELO=claude-opus-5-5
# FABRICA_ESFORCO=medium
# FABRICA_TETO_USD=2          teto de gasto por rodada; passou, o job falha
# WORKER_ID=vps-1
# PASTA_JOBS=/var/lib/bora-fabrica/jobs
# MANTER_PASTA_JOB=1          guarda a pasta local mesmo quando deu certo
# PHOTOCRAFT_CLI=/usr/bin/photocraft-cli   (no Windows ele acha sozinho em worker/.ferramentas)
